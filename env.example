# Claude API 키 (https://console.anthropic.com). 필수.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAlex 무료 API 키 (https://openalex.org 가입 → openalex.org/settings/api). 해외·국내 논문 범위를 크게 넓혀줘요. 강력 권장.
OPENALEX_API_KEY=

# KCI 한국학술지인용색인 Open API 인증키 (https://open.kci.go.kr 에서 이용 신청). 국내 학술지 국문 논문 검색·국문 초록용.
KCI_API_KEY=

# 베타 접속 코드. 넣어두면 이 코드를 아는 사람만 AI 기능과 검색을 쓸 수 있어요. 비워두면 누구나 사용 (비용 주의).
ACCESS_CODE=vet2026

